{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/risk_output.schema.json",
  "title": "Enterprise HAN Agent Risk Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_company",
    "risk_score",
    "primary_meta_path",
    "cascade_reasoning_chain",
    "suggested_action"
  ],
  "properties": {
    "target_company": {
      "type": "string",
      "minLength": 1
    },
    "risk_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "primary_meta_path": {
      "type": "string",
      "minLength": 1
    },
    "cascade_reasoning_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggested_action": {
      "type": "string",
      "minLength": 1
    }
  }
}

